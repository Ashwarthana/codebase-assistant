# Choose generator: ollama, groq, gemini, claude, mock
GENERATOR=ollama

# Ollama settings (local LLaMA on CPU)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# Cloud API keys (only needed if GENERATOR is set to that provider)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
